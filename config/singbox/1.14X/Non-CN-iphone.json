        ],
        "action": "reject",
        "method": "default",
        "no_drop": true
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain_suffix": "push.apple.com"
          },
          {
            "rule_set": "geoip-telegram"
          }
        ],
        "invert": true,
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "stun",
          "quic",
          "dns",
          "bittorrent"
