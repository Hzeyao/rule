  "route": {
    "rules": [
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "network": [
              "tcp",
              "udp"
            ],
            "ip_version": 6,
            "ip_cidr": [
              "2000::/3"
            ]
          },
          {
            "rule_set": "geoip-cn"
          },
          {
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          },
          {
            "port": 53,
            "invert": true
          },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              {
                "clash_mode": "Non-CN"
              },
              {
                "type": "logical",
                "mode": "and",
                "rules": [
                  {
                    "clash_mode": "GFWList"
                  },
                  {
                    "rule_set": [
                      "gfw",
