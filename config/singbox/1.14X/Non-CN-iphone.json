          {
            "protocol": "quic"
          }
        ],
        "action": "reject",
        "no_drop": true
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
