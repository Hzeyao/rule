{
  "$schema": "https://ghgc.hizeyao.com/https://raw.githubusercontent.com/Hzeyao/rule/refs/heads/main/config/singbox/schema.json",
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "local",
        "neighbor_domain": [
          ".",
          ".lan",
          ".home.arpa"
        ]
      },
      {
        "type": "tls",
        "tag": "remote",
        "server": "8.8.8.8",
        "server_port": 853,
        "tls": {
          "enabled": true,
          "server_name": "dns.google"
        },
        "detour": "proxy"
      }
    ],
    "rules": [
      {
        "preferred_by": "local",
        "action": "route",
        "server": "local"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain": [
              "localhost"
            ],
            "domain_suffix": [
              ".local",
              ".lan",
              ".localdomain",
              ".home.arpa",
              ".internal",
              ".intranet"
            ]
          },
          {
            "rule_set": "private"
          }
        ],
        "action": "route",
        "server": "local"
      },
      {
        "domain": [
          "lancache.steamcontent.com"
        ],
        "action": "route",
        "server": "local"
      },
      {
        "rule_set": [
          "geosite-dnsblock",
          "adrules"
        ],
        "action": "predefined",
        "rcode": "NXDOMAIN"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": [
              "AAAA",
              "HTTPS",
              "SVCB"
            ]
          },
          {
            "type": "logical",
            "mode": "and",
            "rules": [
              {
                "clash_mode": "Direct",
                "invert": true
              },
              {
                "rule_set": [
                  "custom-direct-domains",
                  "geosite-wise",
                  "apple",
                  "apple-cn",
                  "apple-proxy"
                ],
                "invert": true
              },
              {
                "rule_set": [
                  "microsoft-cn",
                  "geosite-jetbrains@cn",
                  "gfwlist-custom-domains"
                ]
              }
            ]
          }
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "Direct",
            "invert": true
          },
          {
            "rule_set": [
              "custom-direct-domains",
              "geosite-wise",
              "apple",
              "apple-cn",
              "apple-proxy"
            ],
            "invert": true
          },
          {
            "rule_set": [
              "microsoft-cn",
              "geosite-jetbrains@cn",
              "gfwlist-custom-domains"
            ]
          }
        ],
        "action": "route",
        "server": "remote"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": "AAAA"
          },
          {
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              {
                "clash_mode": "Direct"
              },
              {
                "type": "logical",
                "mode": "and",
                "rules": [
                  {
                    "clash_mode": "Global",
                    "invert": true
                  },
                  {
                    "rule_set": [
                      "custom-direct-domains",
                      "geosite-wise",
                      "apple",
                      "apple-cn",
                      "apple-proxy"
                    ]
                  }
                ]
              },
              {
                "type": "logical",
                "mode": "and",
                "rules": [
                  {
                    "clash_mode": "GFWList"
                  },
                  {
                    "rule_set": [
                      "gfw",
                      "gfwlist-custom-domains"
                    ],
                    "invert": true
                  }
                ]
              },
              {
                "type": "logical",
                "mode": "and",
                "rules": [
                  {
                    "clash_mode": "Non-CN"
                  },
                  {
                    "rule_set": "gfwlist-custom-domains",
                    "invert": true
                  },
                  {
                    "type": "logical",
                    "mode": "or",
                    "rules": [
                      {
                        "rule_set": [
                          "geosite-geolocation-cn",
                          "ext-cn-domain"
                        ]
                      },
                      {
                        "domain_suffix": [
                          "steamcontent.com"
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "clash_mode": "Direct"
          },
          {
            "type": "logical",
            "mode": "and",
            "rules": [
              {
                "clash_mode": "Global",
                "invert": true
              },
              {
                "rule_set": [
                  "custom-direct-domains",
                  "geosite-wise",
                  "apple",
                  "apple-cn",
                  "apple-proxy"
                ]
              }
            ]
          },
          {
            "type": "logical",
            "mode": "and",
            "rules": [
              {
                "clash_mode": "GFWList"
              },
              {
                "rule_set": [
                  "gfw",
                  "gfwlist-custom-domains"
                ],
                "invert": true
              }
            ]
          },
          {
            "type": "logical",
            "mode": "and",
            "rules": [
              {
                "clash_mode": "Non-CN"
              },
              {
                "rule_set": [
                  "microsoft-cn",
                  "geosite-jetbrains@cn",
                  "gfwlist-custom-domains"
                ],
                "invert": true
              },
              {
                "type": "logical",
                "mode": "or",
                "rules": [
                  {
                    "rule_set": [
                      "geosite-geolocation-cn",
                      "ext-cn-domain"
                    ]
                  },
                  {
                    "domain_suffix": [
                      "steamcontent.com"
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "action": "route",
        "server": "local"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "Non-CN"
          },
          {
            "query_type": [
              "A",
              "AAAA"
            ]
          },
          {
            "rule_set": "geosite-geolocation-!cn",
            "invert": true
          }
        ],
        "action": "evaluate",
        "server": "remote",
        "tag": "local-answer",
        "client_subnet": "223.5.5.0/24",
        "timeout": "1s"
      },
      {
        "match_response": "local-answer",
        "ip_is_private": true,
        "action": "respond",
        "race": true
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "query_type": "AAAA"
          },
          {
            "default_interface_address": [
              "2000::/3"
            ],
            "invert": true
          },
          {
            "match_response": "local-answer",
            "response_rcode": "NOERROR",
            "rule_set": "geoip-cn"
          }
        ],
        "action": "predefined",
        "rcode": "NOERROR",
        "race": true
      },
      {
        "match_response": "local-answer",
        "response_rcode": "NOERROR",
        "rule_set": "geoip-cn",
        "action": "route",
        "server": "local",
        "race": true
      },
      {
        "query_type": [
          "AAAA",
          "HTTPS",
          "SVCB"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      }
    ],
    "final": "remote",
    "strategy": "ipv4_only",
    "cache_capacity": 8192,
    "optimistic": {
      "enabled": true,
      "timeout": "1h"
    },
    "reverse_mapping": true
  },
  "http_clients": [
    {
      "tag": "rule-set-download",
      "detour": "proxy"
    }
  ],
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": true,
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 2080
        }
      }
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "interrupt_exist_connections": true,
      "outbounds": [
        "auto"
      ]
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50,
      "idle_timeout": "30m"
    },
    {
      "tag": "Goolge",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "tag": "Youtube",
      "type": "selector",
