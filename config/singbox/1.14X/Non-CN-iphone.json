        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs",
        "update_interval": "1d"
      },
      {
        "tag": [
          "private",
          "gfw",
          "adrules",
          "ai",
          "speedtest",
          "bahamut",
          "crypto",
          "youtube",
          "netflix",
          "google",
