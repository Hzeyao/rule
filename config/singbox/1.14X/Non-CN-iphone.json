        "action": "route",
        "outbound": "AI"
      },
      {
        "rule_set": "pikpak",
        "action": "route",
        "outbound": "Pikpak"
      },
      {
        "rule_set": "speedtest",
        "action": "route",
        "outbound": "Speedtest"
      },
